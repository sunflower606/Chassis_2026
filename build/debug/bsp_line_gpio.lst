   3:bsp/bsp_line_gpio.c **** /* ---------------------------------------------------------------- 引脚表
   4:bsp/bsp_line_gpio.c ****  * 数组下标就是位图里的位号：索引 0 -> bit0 -> CH1（最左）。
   5:bsp/bsp_line_gpio.c ****  * 顺序改错会导致「明明线在左边，程序以为在右边」，改这里时务必对着
   6:bsp/bsp_line_gpio.c ****  *
   7:bsp/bsp_line_gpio.c ****  * 允许跨端口：现在 CH1~CH6 在 GPIOA，CH7 在 GPIOB。
   8:bsp/bsp_line_gpio.c ****  * ---------------------------------------------------------------- */
   9:bsp/bsp_line_gpio.c **** typedef struct {
  10:bsp/bsp_line_gpio.c ****     GPIO_TypeDef *port;
