  18:bsp/bsp_line_gpio.c ****     { BOARD_LINE_GPIO,   BOARD_LINE_CH4_PIN },   /* bit3，正中 */
  19:bsp/bsp_line_gpio.c ****     { BOARD_LINE_GPIO,   BOARD_LINE_CH5_PIN },   /* bit4 */
  20:bsp/bsp_line_gpio.c ****     { BOARD_LINE_GPIO,   BOARD_LINE_CH6_PIN },   /* bit5 */
  21:bsp/bsp_line_gpio.c ****     { BOARD_LINE_B_GPIO, BOARD_LINE_B_CH7_PIN },  /* bit6，最右 */
  22:bsp/bsp_line_gpio.c **** };
