  46:application/chassis_task.c **** /* 模式 2：纯人体跟随
  47:application/chassis_task.c ****  *
  48:application/chassis_task.c ****  * 两路互相独立的输入合成差速：
  49:application/chassis_task.c ****  *
  50:application/chassis_task.c ****  *   转向  <- 云台 yaw 偏角      「云台往哪边转，车就往哪边转」
  51:application/chassis_task.c ****  *   前后  <- 超声波距离闭环      「保持设定车距：太远前进，太近后退」
  52:application/chassis_task.c ****  *
  53:application/chassis_task.c ****  *   left  = 前后 + 转向
  54:application/chassis_task.c ****  *   right = 前后 - 转向
  55:application/chassis_task.c ****  *
  56:application/chassis_task.c ****  * 转向用偏角而不是画面偏差，是因为云台一直把人保持在画面中心，
  57:application/chassis_task.c ****  * 画面偏差恒接近 0（详见 ../docs/双板分工与协议.md）。
  58:application/chassis_task.c ****  */
  59:application/chassis_task.c **** static void ChassisTask_UpdateFollow(void)
  60:application/chassis_task.c **** {
  61:application/chassis_task.c ****     VisionLink_t link;
  62:application/chassis_task.c ****     int16_t dev_tenth;
  63:application/chassis_task.c ****     int32_t steer;
  64:application/chassis_task.c ****     int32_t forward_speed = 0;
  65:application/chassis_task.c ****     int32_t left;
  66:application/chassis_task.c ****     int32_t right;
  67:application/chassis_task.c ****     const int32_t speed_max = (int32_t)CHASSIS_FOLLOW_SPEED_MAX;
  68:application/chassis_task.c ****     const int32_t duty_max = (int32_t)CHASSIS_MOTOR_DUTY_MAX;
  69:application/chassis_task.c **** 
  70:application/chassis_task.c ****     /* ---------- 1. 人丢了 / 链路断：停车等待 ---------- */
  71:application/chassis_task.c ****     if (VisionLink_IsFresh() == 0U) {
  72:application/chassis_task.c ****         Motor_SetSpeed(0, 0);
  73:application/chassis_task.c ****         return;
  74:application/chassis_task.c ****     }
  75:application/chassis_task.c **** 
  76:application/chassis_task.c ****     /* ---------- 2. 转向：云台偏角 ---------- */
  77:application/chassis_task.c ****     link = VisionLink_Get();
  78:application/chassis_task.c ****     dev_tenth = link.yaw_dev_tenth_deg;
  79:application/chassis_task.c **** 
  80:application/chassis_task.c ****     /* 死区：云台微抖不该让车摆头 */
  81:application/chassis_task.c ****     if (dev_tenth > (int16_t)CHASSIS_FOLLOW_STEER_DEADBAND_TENTH_DEG) {
  82:application/chassis_task.c ****         dev_tenth = (int16_t)(dev_tenth - (int16_t)CHASSIS_FOLLOW_STEER_DEADBAND_TENTH_DEG);
  83:application/chassis_task.c ****     } else if (dev_tenth < -(int16_t)CHASSIS_FOLLOW_STEER_DEADBAND_TENTH_DEG) {
  84:application/chassis_task.c ****         dev_tenth = (int16_t)(dev_tenth + (int16_t)CHASSIS_FOLLOW_STEER_DEADBAND_TENTH_DEG);
  85:application/chassis_task.c ****     } else {
  86:application/chassis_task.c ****         dev_tenth = 0;
  87:application/chassis_task.c ****     }
  88:application/chassis_task.c **** 
  89:application/chassis_task.c ****     /* 0.1 度 × (千分比/度) / 10 = 千分比 */
ARM GAS  C:\Users\XIANGR~1\AppData\Local\Temp\ccdKZ92p.s 			page 3


  90:application/chassis_task.c ****     steer = ((int32_t)dev_tenth * (int32_t)CHASSIS_FOLLOW_STEER_GAIN_Q) / 10;
  91:application/chassis_task.c ****     steer = steer * (int32_t)CHASSIS_FOLLOW_STEER_SIGN;
  92:application/chassis_task.c **** 
  93:application/chassis_task.c ****     if (steer > duty_max) {
  94:application/chassis_task.c ****         steer = duty_max;
  95:application/chassis_task.c ****     }
  96:application/chassis_task.c ****     if (steer < -duty_max) {
  97:application/chassis_task.c ****         steer = -duty_max;
  98:application/chassis_task.c ****     }
  99:application/chassis_task.c **** 
 100:application/chassis_task.c ****     /* ---------- 3. 前后：超声波距离闭环 ---------- */
 101:application/chassis_task.c ****     if (DistanceSensor_IsValid() != 0U) {
 102:application/chassis_task.c ****         int32_t error_cm = (int32_t)DistanceSensor_GetCm()
 103:application/chassis_task.c ****                          - (int32_t)CHASSIS_FOLLOW_TARGET_DISTANCE_CM;
 104:application/chassis_task.c ****         const int32_t deadband_cm = (int32_t)CHASSIS_FOLLOW_DISTANCE_DEADBAND_CM;
 105:application/chassis_task.c **** 
 106:application/chassis_task.c ****         /* 距离死区：差在范围内就不前后动，避免原地来回蹭 */
 107:application/chassis_task.c ****         if (error_cm > deadband_cm) {
 108:application/chassis_task.c ****             error_cm -= deadband_cm;
 109:application/chassis_task.c ****         } else if (error_cm < -deadband_cm) {
 110:application/chassis_task.c ****             error_cm += deadband_cm;
 111:application/chassis_task.c ****         } else {
 112:application/chassis_task.c ****             error_cm = 0;
 113:application/chassis_task.c ****         }
 114:application/chassis_task.c **** 
 115:application/chassis_task.c ****         /* 千分比/cm × cm = 千分比；正 = 太远 = 前进，负 = 太近 = 后退 */
 116:application/chassis_task.c ****         forward_speed = error_cm * (int32_t)CHASSIS_FOLLOW_DISTANCE_GAIN_Q;
 117:application/chassis_task.c **** 
 118:application/chassis_task.c ****         if (forward_speed > speed_max) {
 119:application/chassis_task.c ****             forward_speed = speed_max;
 120:application/chassis_task.c ****         }
 121:application/chassis_task.c ****         if (forward_speed < -speed_max) {
 122:application/chassis_task.c ****             forward_speed = -speed_max;
 123:application/chassis_task.c ****         }
 124:application/chassis_task.c ****     } else {
 125:application/chassis_task.c **** #if (CHASSIS_FOLLOW_REQUIRE_DISTANCE != 0)
 126:application/chassis_task.c ****         /* 测不到有效距离：既不会前进也不会后退，直接停。
 127:application/chassis_task.c ****          * 这里不「只转向不前进」—— 差速会让车原地打转，反而危险。 */
 128:application/chassis_task.c ****         Motor_SetSpeed(0, 0);
 129:application/chassis_task.c ****         return;
 130:application/chassis_task.c **** #else
 131:application/chassis_task.c ****         /* 退化成定速前进（仅调试用） */
 132:application/chassis_task.c ****         forward_speed = (int32_t)CHASSIS_FOLLOW_BASE_SPEED;
 133:application/chassis_task.c **** #endif
 134:application/chassis_task.c ****     }
 135:application/chassis_task.c **** 
 136:application/chassis_task.c ****     /* ---------- 4. 合成差速 ---------- */
 137:application/chassis_task.c ****     left = forward_speed + steer;
 138:application/chassis_task.c ****     right = forward_speed - steer;
 139:application/chassis_task.c **** 
 140:application/chassis_task.c ****     /* 允许为负：太近时要能倒车。但仍要夹在硬件限幅内。 */
 141:application/chassis_task.c ****     if (left > duty_max) {
 142:application/chassis_task.c ****         left = duty_max;
 143:application/chassis_task.c ****     }
 144:application/chassis_task.c ****     if (left < -duty_max) {
 145:application/chassis_task.c ****         left = -duty_max;
 146:application/chassis_task.c ****     }
ARM GAS  C:\Users\XIANGR~1\AppData\Local\Temp\ccdKZ92p.s 			page 4


 147:application/chassis_task.c ****     if (right > duty_max) {
 148:application/chassis_task.c ****         right = duty_max;
 149:application/chassis_task.c ****     }
 150:application/chassis_task.c ****     if (right < -duty_max) {
 151:application/chassis_task.c ****         right = -duty_max;
 152:application/chassis_task.c ****     }
 153:application/chassis_task.c **** 
 154:application/chassis_task.c ****     Motor_SetSpeed((int16_t)left, (int16_t)right);
 155:application/chassis_task.c **** }
