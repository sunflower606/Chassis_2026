   1:bsp/bsp_ultrasonic.c **** #include "bsp_ultrasonic.h"
   2:bsp/bsp_ultrasonic.c **** 
   3:bsp/bsp_ultrasonic.c **** #include "board_config.h"
   4:bsp/bsp_ultrasonic.c **** #include "Delay.h"
   5:bsp/bsp_ultrasonic.c **** 
   6:bsp/bsp_ultrasonic.c **** /* ============================================================================
   7:bsp/bsp_ultrasonic.c ****  * 实现说明
   8:bsp/bsp_ultrasonic.c ****  *
   9:bsp/bsp_ultrasonic.c ****  * 这套接法下 Echo 接在 PB15，而本板**没有空闲的定时器捕获通道**
  10:bsp/bsp_ultrasonic.c ****  * （TIM2/TIM4 归编码器、TIM3 出 PWM、TIM1 的捕获脚 PA8~PA11 被循迹占用），
  11:bsp/bsp_ultrasonic.c ****  * 所以测量方式改成：
  12:bsp/bsp_ultrasonic.c ****  *   1) TIM1 配成 1 MHz 自由运行时基（不需要任何引脚），
  13:bsp/bsp_ultrasonic.c ****  *      每 65536 us 溢出一次，溢出中断里累加高位；
  14:bsp/bsp_ultrasonic.c ****  *   2) EXTI 线 15 配成**双边沿中断**：
  15:bsp/bsp_ultrasonic.c ****  *      上升沿 -> 记下回波起点，把触发条件切成下降沿；
  16:bsp/bsp_ultrasonic.c ****  *      下降沿 -> 算出脉宽，把触发条件切回上升沿。
  17:bsp/bsp_ultrasonic.c ****  *
  18:bsp/bsp_ultrasonic.c ****  * 为什么不用 GPIO 轮询：控制环 5 ms 一轮，1 ms 误差折合 17 cm。
  19:bsp/bsp_ultrasonic.c ****  *
  20:bsp/bsp_ultrasonic.c ****  * 为什么 EXTI 用寄存器写而不是 SPL：
  21:bsp/bsp_ultrasonic.c ****  *   本工程 Drivers 里没有 stm32f10x_exti.c（只有 .h），
  22:bsp/bsp_ultrasonic.c ****  *   而 BSP 层本来就是唯一允许直接碰寄存器的层，所以直接写 AFIO/EXTI。
  23:bsp/bsp_ultrasonic.c ****  * ========================================================================== */
  24:bsp/bsp_ultrasonic.c **** 
  25:bsp/bsp_ultrasonic.c **** /* EXTI 线掩码 */
  26:bsp/bsp_ultrasonic.c **** #define ULTRASONIC_EXTI_MASK    (1UL << BOARD_ULTRASONIC_ECHO_EXTI_LINE)
  27:bsp/bsp_ultrasonic.c **** 
  28:bsp/bsp_ultrasonic.c **** /* 捕获状态机 */
  29:bsp/bsp_ultrasonic.c **** static volatile uint8_t  s_wait_rise = 1U;      /* 1 = 等上升沿，0 = 等下降沿 */
  30:bsp/bsp_ultrasonic.c **** static volatile uint32_t s_rise_us = 0U;        /* 回波起点时刻，us */
  31:bsp/bsp_ultrasonic.c **** static volatile uint16_t s_width_us = 0U;       /* 算好的脉宽，us */
  32:bsp/bsp_ultrasonic.c **** static volatile uint8_t  s_have_echo = 0U;      /* 1 = 有新脉宽可取 */
ARM GAS  C:\Users\XIANGR~1\AppData\Local\Temp\ccHfsGfs.s 			page 2


  33:bsp/bsp_ultrasonic.c **** 
  34:bsp/bsp_ultrasonic.c **** /* TIM1 自由运行时基的高位（每 65536 us 加一次） */
  35:bsp/bsp_ultrasonic.c **** static volatile uint32_t s_us_high = 0U;
  36:bsp/bsp_ultrasonic.c **** 
  37:bsp/bsp_ultrasonic.c **** /* ------------------------------------------------------------------------- */
  38:bsp/bsp_ultrasonic.c **** /* 读当前时刻（us，32 位）
  39:bsp/bsp_ultrasonic.c ****  *
  40:bsp/bsp_ultrasonic.c ****  * 16 位计数器 + 高位组合，必须避免「读高位 -> 计数器溢出 -> 读计数器」
  41:bsp/bsp_ultrasonic.c ****  * 这种撕裂。做法是读两遍高位，不一致就重读。 */
  42:bsp/bsp_ultrasonic.c **** static uint32_t BSP_Ultrasonic_GetTimeUs(void)
  43:bsp/bsp_ultrasonic.c **** {
  44:bsp/bsp_ultrasonic.c ****     uint32_t high_first;
  45:bsp/bsp_ultrasonic.c ****     uint32_t high_second;
  46:bsp/bsp_ultrasonic.c ****     uint32_t counter;
  47:bsp/bsp_ultrasonic.c **** 
  48:bsp/bsp_ultrasonic.c ****     do {
  49:bsp/bsp_ultrasonic.c ****         high_first = s_us_high;
  50:bsp/bsp_ultrasonic.c ****         counter = (uint32_t)TIM_GetCounter(BOARD_ULTRASONIC_TIM);
  51:bsp/bsp_ultrasonic.c ****         high_second = s_us_high;
  52:bsp/bsp_ultrasonic.c ****     } while (high_first != high_second);
  53:bsp/bsp_ultrasonic.c **** 
  54:bsp/bsp_ultrasonic.c ****     return high_second + counter;
  55:bsp/bsp_ultrasonic.c **** }
  56:bsp/bsp_ultrasonic.c **** 
  57:bsp/bsp_ultrasonic.c **** /* 切换 EXTI 触发边沿：rising != 0 用上升沿，否则下降沿 */
