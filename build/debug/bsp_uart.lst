  70:bsp/bsp_uart.c **** uint16_t BSP_UART_GetRxCount(void)
  71:bsp/bsp_uart.c **** {
  72:bsp/bsp_uart.c ****     uint16_t head = s_rx_head;
  73:bsp/bsp_uart.c ****     uint16_t tail = s_rx_tail;
  74:bsp/bsp_uart.c **** 
  75:bsp/bsp_uart.c ****     if (head >= tail) {
  76:bsp/bsp_uart.c ****         return (uint16_t)(head - tail);
  77:bsp/bsp_uart.c ****     }
  78:bsp/bsp_uart.c **** 
  79:bsp/bsp_uart.c ****     return (uint16_t)(BOARD_LINK_RX_BUF_SIZE - tail + head);
  80:bsp/bsp_uart.c **** }
