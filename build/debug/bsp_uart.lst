  50:bsp/bsp_uart.c **** void BSP_UART_SendByte(uint8_t byte)
  51:bsp/bsp_uart.c **** {
  52:bsp/bsp_uart.c ****     USART_SendData(BOARD_LINK_UART, (uint16_t)byte);
  53:bsp/bsp_uart.c ****     while (USART_GetFlagStatus(BOARD_LINK_UART, USART_FLAG_TXE) == RESET) {
  54:bsp/bsp_uart.c ****         /* 等待发送数据寄存器空 */
  55:bsp/bsp_uart.c ****     }
  56:bsp/bsp_uart.c **** }
  57:bsp/bsp_uart.c **** 
  58:bsp/bsp_uart.c **** void BSP_UART_SendString(const char *text)
  59:bsp/bsp_uart.c **** {
  60:bsp/bsp_uart.c ****     if (text == NULL) {
  61:bsp/bsp_uart.c ****         return;
  62:bsp/bsp_uart.c ****     }
  63:bsp/bsp_uart.c **** 
  64:bsp/bsp_uart.c ****     while (*text != '\0') {
  65:bsp/bsp_uart.c ****         BSP_UART_SendByte((uint8_t)(*text));
  66:bsp/bsp_uart.c ****         text++;
  67:bsp/bsp_uart.c ****     }
  68:bsp/bsp_uart.c **** }
