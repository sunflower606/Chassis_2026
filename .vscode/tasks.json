{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: configure",
            "type": "shell",
            "command": "D:\\EdgeAI\\yolo_env\\Scripts\\cmake.exe",
            "args": [
                "--preset",
                "f103"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "CMake: build",
            "type": "shell",
            "command": "D:\\EdgeAI\\yolo_env\\Scripts\\cmake.exe",
            "args": [
                "--build",
                "--preset",
                "f103"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "CMake: configure",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "CMake: clean",
            "type": "shell",
            "command": "D:\\EdgeAI\\yolo_env\\Scripts\\cmake.exe",
            "args": [
                "--build",
                "--preset",
                "f103",
                "--target",
                "clean"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Flash: OpenOCD ST-Link",
            "type": "shell",
            "command": "D:\\Microsoft VS code\\stm32tools\\@xpack-dev-tools\\openocd\\0.12.0-7.1\\.content\\bin\\openocd.exe",
            "args": [
                "-f",
                "openocd.cfg",
                "-c",
                "program build-cmake/Chassis_2026.elf verify reset exit"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "CMake: build",
            "problemMatcher": []
        },
        {
            "label": "Build STM",
            "type": "process",
            "command": "${command:stm32-for-vscode.build}",
            "options": {
                "cwd": "${workspaceRoot}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Build Clean STM",
            "type": "process",
            "command": "${command:stm32-for-vscode.cleanBuild}",
            "options": {
                "cwd": "${workspaceRoot}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Flash STM",
            "type": "process",
            "command": "${command:stm32-for-vscode.flash}",
            "options": {
                "cwd": "${workspaceRoot}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}
